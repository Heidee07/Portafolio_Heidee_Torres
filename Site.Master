<%@ Master Language="VB" AutoEventWireup="true" CodeBehind="Site.master.vb" Inherits="Portafolio_Heidee_Torres.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow">
    <title><%: Page.Title %> | Heidee Torres</title>
    <link rel="icon" href="~/Images/favicon.png" type="image/png" />

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="Styles/Typography_Style.css" />
    <link rel="stylesheet" href="Styles/Theme_Style.css" />

    <%--Google Analitics--%>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5GV03PGN6D"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-5GV03PGN6D');
    </script>

</head>
<body class="body-gradient" data-bs-spy="scroll" data-bs-target=".navbar" data-bs-offset="90" tabindex="0">
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>

        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg sticky-top bg-body-tertiary">
            <div class="container-fluid">

                <button class="navbar-toggler order-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <a class="navbar-brand order-2 order-lg-1 mx-auto ms-lg-4" href="#header">
                    <span class="spn1-nav-brand">Hei</span><span class="spn2-nav-brand">Deev</span>
                </a>

                <div class="collapse navbar-collapse order-4 order-lg-2" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-0 mb-lg-0" style="margin: 0 auto;">
                        <li class="nav-item">
                            <a class="nav-link txt-nav" href="#sobre-mi" data-i18n="nav_sobre_mi">Sobre Mí</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link txt-nav" href="#proyectos" data-i18n="nav_mis_proyectos">Mis Proyectos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link txt-nav" href="#habilidades" data-i18n="nav_mis_habilidades">Mis Habilidades</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link txt-nav" href="#trayectoria" data-i18n="nav_mi_trayectoria">Mi Trayectoria</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link txt-nav" href="#networking" data-i18n="nav_networking">Networking</a>
                        </li>
                    </ul>
                </div>

                <div class="lang-toggle d-flex align-items-center order-3 order-lg-3 me-3 me-lg-4">
                    <i class="bi bi-translate i-translate"></i>
                    <a href="javascript:void(0);" class="lang-link active" title="Español" id="btn-es" onclick="cambiarIdioma('es')">ES</a>
                    <span class="lang-separator mx-2">|</span>
                    <a href="javascript:void(0);" class="lang-link" title="English" id="btn-en" onclick="cambiarIdioma('en')">EN</a>
                </div>

            </div>
        </nav>

        <div class="body-content" style="margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; width: 100%;">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />

            <div class="footer-divider" style="height: 2px; background: linear-gradient(90deg, transparent, #D22AA8, transparent);"></div>

            <footer class="py-4" style="background-color: #0D0C0E;">
                <div class="container">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">

                        <div class="text-light opacity-75 small text-center text-md-start" data-i18n="derechos_footer">
                            &copy; <%: DateTime.Now.Year %> HeiDeev | Heidee Torres.
                 <br class="d-md-none">
                            Todos los derechos reservados.
                        </div>

                        <div class="d-flex align-items-center justify-content-center text-light opacity-75 small">
                            <span class="me-2" data-i18n="devtools_footer">Desarrollado con:</span>
                            <i class="devicon-html5-plain fs-4 mx-1 tech-icon-footer" title="HTML5"></i>
                            <i class="devicon-css3-plain fs-4 mx-1 tech-icon-footer" title="CSS3"></i>
                            <i class="devicon-visualbasic-plain fs-4 mx-1 tech-icon-footer" title="Visual Basic"></i>
                            <i class="devicon-javascript-plain fs-4 mx-1 tech-icon-footer" title="Javascript"></i>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="mailto:hei752.dee@gmail.com" class="social-icon-footer">
                                <i class="bi bi-envelope-fill fs-5"></i>
                            </a>
                            <a href="https://www.linkedin.com/in/heidee-judith-t-1a00b330a" target="_blank" class="social-icon-footer">
                                <i class="bi bi-linkedin fs-5"></i>
                            </a>
                            <%--<a href="#" target="_blank" class="social-icon-footer">
                                <i class="bi bi-github fs-5"></i>
                            </a>--%>
                        </div>

                    </div>
                </div>
            </footer>

        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
        <%--<script src="~/Scripts/Traducciones/traducciones.js"></script>--%>
        <script src="<%= ResolveUrl("~/Scripts/Traducciones/traducciones.js") %>"></script>
</body>
</html>
